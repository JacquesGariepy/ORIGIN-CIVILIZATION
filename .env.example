# ORIGIN Civilization 6.1 / TypeSafe native by default.
# Copy to .env; never publish .env. Restart the server after changing it.
PORT=4317
# No OpenRouter account is needed for native Jev.
# A key entered in the browser is held in server memory until disconnect/shutdown.
TYPESAFE_API_KEY=
# Hard server limits supplement (never automatically raise) UI request allowances.
# Totals include historical attempts restored with a world. Up to 100000 Jev / 10000 planner calls.
SERVER_JEV_CAP=2000
SERVER_PLANNER_CAP=100
# Upper bound on simultaneous decision/planner calls in the local world.
SERVER_CONCURRENCY=8
# Optional local agy planner with its own restricted provider/authentication.
AGY_ENABLED=0
AGY_COMMAND=
AGY_MODEL=
AGY_SANDBOX=1
# Optional alternative Jev provider and/or separate OpenRouter text planner.
OPENROUTER_API_KEY=
PLANNER_API_KEY=
PLANNER_MODEL=
# Optional planners below only PROPOSE; TypeSafe Jev remains the only decider. See docs/LLM-PLANNERS.md.
# OpenAI-compatible API or local LLM (Ollama http://127.0.0.1:11434/v1, LM Studio http://127.0.0.1:1234/v1,
# llama.cpp, vLLM, OpenAI, Mistral, Groq...). https, or plain http on loopback only. Key optional for local servers.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=
# Claude Code CLI with your existing sign-in: no tools, no MCP, safe mode, nothing persisted.
CLAUDE_ENABLED=0
CLAUDE_COMMAND=
CLAUDE_MODEL=
CLAUDE_MAX_BUDGET_USD=
# Codex CLI with your existing sign-in: read-only sandbox, ephemeral; set CODEX_USER_CONFIG=1 to load config.toml.
CODEX_ENABLED=0
CODEX_COMMAND=
CODEX_MODEL=
CODEX_USER_CONFIG=0
