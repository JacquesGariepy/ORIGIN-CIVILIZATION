# ORIGIN Civilization 6.0 / TypeSafe native by default.
# Copy to .env; never publish .env. Restart the server after changing it.
PORT=4317
# No OpenRouter account is needed for native Jev.
# A key entered in the browser is held in server memory until disconnect/shutdown.
TYPESAFE_API_KEY=
# Hard server limits supplement (never automatically raise) UI request allowances.
SERVER_JEV_CAP=2000
SERVER_PLANNER_CAP=100
# Upper bound on simultaneous decision/planner calls in the local world.
SERVER_CONCURRENCY=8
# Optional local agy planner with its own restricted provider/authentication.
AGY_ENABLED=0
AGY_COMMAND=
AGY_MODEL=
AGY_SANDBOX=1
# Optional alternative Jev provider and/or separate OpenRouter text planner.
OPENROUTER_API_KEY=
PLANNER_API_KEY=
PLANNER_MODEL=
